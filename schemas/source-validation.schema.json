{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familyos.local/schemas/source-validation.schema.json",
  "title": "FamilyOS Source Validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "summary"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "domain",
          "publisher",
          "publicationDate",
          "author",
          "sourceType",
          "score",
          "accepted",
          "reason"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "publicationDate": {
            "type": ["string", "null"],
            "format": "date"
          },
          "author": {
            "type": ["string", "null"]
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "Official",
              "HealthAuthority",
              "University",
              "Hospital",
              "ScientificJournal",
              "ScientificStudy",
              "EducationalInstitution",
              "CulturalInstitution",
              "QualityPopularization",
              "Media",
              "Commercial",
              "Unknown"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": -20,
            "maximum": 20
          },
          "accepted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "readingTimeMinutes": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "summary": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "accepted", "rejected"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

