{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familyos.local/schemas/family-context.schema.json",
  "title": "FamilyOS Family Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "child",
    "recentMeetings",
    "recentCategories",
    "existingTopics",
    "openDecisions",
    "topicBacklog",
    "preferences"
  ],
  "properties": {
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["birthDate", "ageMonths", "ageYears", "ageLabel"],
      "properties": {
        "birthDate": {
          "type": "string",
          "format": "date"
        },
        "ageMonths": {
          "type": "integer",
          "minimum": 0
        },
        "ageYears": {
          "type": "integer",
          "minimum": 0
        },
        "ageLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recentMeetings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "recentCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existingTopics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "topicBacklog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

