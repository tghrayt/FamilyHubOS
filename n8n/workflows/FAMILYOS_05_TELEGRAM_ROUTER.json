      "id": "telegram-webhook",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "familyos-telegram-router"
    },
    {
      "parameters": {
        "jsCode": "const update = $json;\nconst message = update.message || update.edited_message || null;\nconst callbackQuery = update.callback_query || null;\nconst callbackMessage = callbackQuery?.message || null;\nconst sourceMessage = message || callbackMessage || {};\nconst from = callbackQuery?.from || message?.from || {};\nconst chat = sourceMessage.chat || {};\nconst text = message?.text || null;\nconst callbackData = callbackQuery?.data || null;\nconst command = text && text.startsWith('/') ? text.split(/\\s+/)[0].slice(1).split('@')[0] : null;\nconst type = callbackData ? 'callback' : command ? 'command' : 'message';\n\nreturn [\n  {\n    json: {\n      rawUpdateId: update.update_id?.toString() || null,\n      interactionId: callbackQuery?.id || update.update_id?.toString() || `${Date.now()}`,\n      chatId: chat.id?.toString() || '',\n      userId: from.id?.toString() || '',\n      username: from.username || null,\n      receivedAt: new Date().toISOString(),\n      type,\n      command,\n      callbackData,\n      messageText: text,\n      authorized: false,\n      payload: {\n        updateId: update.update_id || null,\n        messageId: sourceMessage.message_id || null,\n        callbackQueryId: callbackQuery?.id || null,\n        firstName: from.first_name || null,\n        lastName: from.last_name || null\n      }\n    }\n  }\n];"
      },
      "id": "normalize-telegram-update",
      "name": "Normalize Telegram Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const allowedUsers = ($env.TELEGRAM_ALLOWED_USER_IDS || '')\n  .split(',')\n  .map(x => x.trim())\n  .filter(Boolean);\nconst allowedChats = ($env.TELEGRAM_ALLOWED_CHAT_IDS || '')\n  .split(',')\n  .map(x => x.trim())\n  .filter(Boolean);\n\nreturn items.map(item => {\n  const userAllowed = allowedUsers.length === 0 ? false : allowedUsers.includes(item.json.userId);\n  const chatAllowed = allowedChats.length === 0 ? false : allowedChats.includes(item.json.chatId);\n  item.json.authorized = userAllowed && chatAllowed;\n  item.json.payload.authorization = {\n    userAllowed,\n    chatAllowed\n  };\n  return item;\n});"
      },
      "id": "authorize-telegram-interaction",
      "name": "Authorize Telegram Interaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
