    {
      "parameters": {
        "jsCode": "return items.map(item => ({ json: { ...item.json, route: 'help', responseText: 'Commandes MVP: /choose, /idea, /status. Les autres commandes seront ajoutées progressivement.' } }));"
      },
      "id": "handle-help",
      "name": "Handle /help",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -240]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({ json: { ...item.json, route: 'choose', responseText: 'Préparons le prochain meeting. Choisis automatique, catégorie, sujet direct ou idées en attente.', nextWorkflow: 'FAMILYOS_01_WEEKLY_PLANNER' } }));"
      },
      "id": "handle-choose",
      "name": "Handle /choose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -120]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const ideaText = (item.json.messageText || '').replace(/^\\/idea(@\\w+)?\\s*/i, '').trim();\n  return {\n    json: {\n      ...item.json,\n      route: 'idea',\n      idea: {\n        text: ideaText,\n        author: item.json.username || item.json.userId,\n        source: 'Telegram',\n        status: 'Idea'\n      },\n      responseText: ideaText ? 'Idée ajoutée au backlog FamilyOS.' : 'Ajoute ton idée après la commande, par exemple: /idea Comment transmettre plusieurs langues à notre enfant ?'\n    }\n  };\n});"
      },
      "id": "handle-idea",
      "name": "Handle /idea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({ json: { ...item.json, route: 'status', responseText: 'FamilyOS est joignable. Les intégrations Notion, Calendar et Research seront branchées dans les prochaines étapes.' } }));"
      },
      "id": "handle-status",
      "name": "Handle /status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 120]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({ json: { ...item.json, route: 'callback', responseText: 'Choix reçu. Le traitement sera branché sur le Weekly Planner.' } }));"
      },
      "id": "handle-callback",
      "name": "Handle Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 240]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({ json: { ...item.json, route: 'unknown', responseText: 'Commande non reconnue. Utilise /help pour voir les commandes disponibles.' } }));"
      },
