# FamilyOS environment example
# Copy values into n8n credentials, n8n environment variables, or a local .env when relevant.
# Never put real secrets in this file.

TZ=Europe/Paris

# Existing automation infrastructure
N8N_NAMESPACE=automation
N8N_HOST=
N8N_PROTOCOL=https

# Existing PostgreSQL instance in namespace automation
POSTGRES_HOST=n8n-postgres
POSTGRES_PORT=5432
POSTGRES_DB=familyos
POSTGRES_USER=familyos
POSTGRES_PASSWORD=

# Telegram allowlists
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# Family context used by the n8n workflow
FAMILYHUBOS_CHILD_BIRTH_DATE=

# Notion database IDs
NOTION_MEETINGS_DATABASE_ID=
NOTION_TOPICS_DATABASE_ID=
NOTION_SOURCES_DATABASE_ID=
NOTION_DECISIONS_DATABASE_ID=
NOTION_FEEDBACK_DATABASE_ID=

# Google Calendar
GOOGLE_CALENDAR_ID=

# LLM provider
LLM_PROVIDER=openai
LLM_MODEL=

# Web search provider
WEB_SEARCH_PROVIDER=

# Source validation
SOURCE_SCORE_THRESHOLD=5
